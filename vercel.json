{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "rewrites": [
    {
      "source": "/",
      "destination": "/resource/public/studio-v2.html"
    }
  ],
  "headers": [
    {
      "source": "/resource/public/studio-v2.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
